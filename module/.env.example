# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000

# SMTP credentials used to send reminder emails (e.g. a Gmail App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Exigency Management System <your-email@gmail.com>"

# IMAP credentials for reading replies to outgoing exigency emails (defaults
# to the SMTP_* values above if omitted — same Gmail App Password works for
# both). Only set these if replies should be read from a different mailbox.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your-email@gmail.com
# IMAP_PASS=your-app-password
