# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000

# Secret the Apps Script webhook must send in the X-Webhook-Secret header.
# Generate any random string; must match Settings!WebhookSecret in Apps Script.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# SMTP credentials used to send reminder emails (e.g. a Gmail App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Exigency Management System <your-email@gmail.com>"
